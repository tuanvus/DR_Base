<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <!-- Colored Console Appender -->
  <appender name="ColoredConsoleAppender" type="log4net.Appender.ColoredConsoleAppender">
    <target value="Console.Out" />
    
    <!-- Optional: Threshold cho appender này riêng -->
    <!-- <threshold value="INFO" /> -->
    
    <!-- DEBUG - Cyan -->
    <mapping>
      <level value="DEBUG" />
      <foreColor value="Cyan" />
    </mapping>
    
    <!-- INFO - Green -->
    <mapping>
      <level value="INFO" />
      <foreColor value="Green" />
    </mapping>
    
    <!-- WARN - Yellow -->
    <mapping>
      <level value="WARN" />
      <foreColor value="Yellow, HighIntensity" />
    </mapping>
    
    <!-- ERROR - Red -->
    <mapping>
      <level value="ERROR" />
      <foreColor value="Red, HighIntensity" />
    </mapping>
    
    <!-- FATAL - Red background -->
    <mapping>
      <level value="FATAL" />
      <foreColor value="White" />
      <backColor value="Red, HighIntensity" />
    </mapping>
    
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{HH:mm:ss} [%thread] %-5level - %message%newline" />
    </layout>
  </appender>

  <!-- File Appender - có thể set level khác với console -->
  <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/server.log" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value="yyyyMMdd" />
    <maxSizeRollBackups value="10" />
    <maximumFileSize value="10MB" />
    <staticLogFileName value="true" />
    
    <!-- File chỉ log WARNING trở lên -->
    <threshold value="WARN" />
    
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%exception" />
    </layout>
  </appender>

  <!-- Root logger - QUAN TRỌNG: Đây là nơi set global log level -->
  <root>
    <!-- 
      Thay đổi value này để control log level:
      - DEBUG: Hiển thị tất cả (DEBUG, INFO, WARN, ERROR, FATAL)
      - INFO: Không hiển thị DEBUG, chỉ INFO và cao hơn
      - WARN: Chỉ WARN, ERROR, FATAL
      - ERROR: Chỉ ERROR và FATAL
    -->
    <level value="DEBUG" />
    
    <appender-ref ref="ColoredConsoleAppender" />
    <appender-ref ref="RollingFileAppender" />
  </root>
</log4net>
