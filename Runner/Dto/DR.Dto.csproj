<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>DR.Dto</RootNamespace>
    <AssemblyName>DR.Dto</AssemblyName>
    
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="2.6.100-alpha" />
    <PackageReference Include="MessagePack.SourceGenerator" Version="2.6.100-alpha" PrivateAssets="all" />
  </ItemGroup>

  <!-- Exclude generated files from compilation -->
  <ItemGroup>
    <Compile Remove="Generated\**\*.cs" />
  </ItemGroup>

</Project>
